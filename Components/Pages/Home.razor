@page "/"
@layout NullLayout
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Theme Persistence Hub</PageTitle>

<div class="app-wrapper @currentThemeClass">
    <header class="top-navbar">
        <div class="navbar-container">
            <div class="navbar-brand">
                <span class="brand-icon">🎨</span>
                <span class="brand-text">Theme Hub</span>
            </div>
            <nav class="navbar-links">
                <a href="" class="nav-link active">Home</a>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="card">
            <div class="card-header">
                <h2>Task 7: Local Storage Theme Persistence</h2>
                <p class="subtitle">Utilizing JS Interop bridges to cache user interface layouts across browser refreshes</p>
            </div>

            <div class="card-body">
                <div class="control-panel">
                    <h3>Theme Control Station</h3>
                    <p class="panel-desc">
                        Click the interactive toggle below to rewrite your local storage dictionary entry.
                        A browser reload or hard refresh cycle will respect your cached selection.
                    </p>

                    <div class="toggle-action-row">
                        <button class="btn-theme-toggle" @onclick="ToggleTheme">
                            @if (isDarkMode)
                            {
                                <span class="btn-content">☀️ Switch to Light Mode</span>
                            }
                            else
                            {
                                <span class="btn-content">🌙 Switch to Dark Mode</span>
                            }
                        </button>
                    </div>

                    <div class="status-indicator">
                        Current Target State Class: <span class="theme-badge">@currentThemeClass</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <div class="footer-content">
            <p class="developer-credit">Developed by <span class="dev-name">Abdul Rehman Ali</span></p>
            <p class="assignment-info">VP Lab Work &bull; Assignment 4 &bull; Task 7</p>
        </div>
    </footer>
</div>

@code {
    private bool isDarkMode = false;
    private string currentThemeClass => isDarkMode ? "dark-mode" : "light-mode";

    // Blazor Server Safety Wrapper Check: Guarantees localStorage reading only happens AFTER client browser handshake
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Pull value out of browser storage dictionary context keys
                var cachedTheme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "user-app-theme");

                if (!string.IsNullOrEmpty(cachedTheme))
                {
                    isDarkMode = cachedTheme == "dark-mode";
                    StateHasChanged(); // Force markup DOM state recalculation tree refresh
                }
            }
            catch (Exception)
            {
                // Graceful fallback safeguard context container handling
            }
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;

        try
        {
            // Direct write mutation invocation routing out to browser memory spaces
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "user-app-theme", currentThemeClass);
        }
        catch (Exception)
        {
            // Error boundary safe execution container context handler
        }
    }
}

@code {
    private class NullLayout : LayoutComponentBase
    {
        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            builder.AddContent(0, Body);
        }
    }
}

